    <Window x:Class="WorkstationSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation Simulation" Height="430" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Fog Lamp Workstation Simulation"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Station selector -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Station:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbStation" Width="250" FontSize="14"/>
            </StackPanel>

            <!-- Start / Stop buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="btnStart" Content="Start Simulation" Width="130" Height="35"
                        Margin="0,0,10,0" Click="btnStart_Click"
                        Background="#FF28A745" Foreground="White" FontWeight="SemiBold"/>
                <Button x:Name="btnStop" Content="Stop" Width="80" Height="35"
                        Click="btnStop_Click" IsEnabled="False"
                        Background="#FFDC3545" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock x:Name="txtStation" Text="" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <TextBlock x:Name="txtStatus" Text="Select a station and click Start."
                       FontSize="14" HorizontalAlignment="Center"
                       Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Stopwatch + progress bar panel -->
            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="5"
                    Padding="14,10" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stopwatch label -->
                    <TextBlock Text="Cycle Time" FontSize="11" Foreground="Gray"
                               Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,12,0"/>
                    <TextBlock x:Name="txtStopwatch" Text="--:--.--"
                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                               Grid.Row="0" Grid.Column="1"/>
                    <TextBlock x:Name="txtTargetTime" Text="" FontSize="11" Foreground="Gray"
                               Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom"/>

                    <!-- Spacer row 1 -->

                    <!-- Progress bar -->
                    <TextBlock Text="Progress" FontSize="11" Foreground="Gray"
                               Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar x:Name="progressBuild" Grid.Row="2" Grid.Column="1"
                                 Grid.ColumnSpan="2" Height="22"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="#FF28A745"/>

                    <!-- Spacer row 3 -->

                    <!-- Last result -->
                    <TextBlock Text="Last" FontSize="11" Foreground="Gray"
                               Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="txtLastResult" Text="—"
                               FontSize="12" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
