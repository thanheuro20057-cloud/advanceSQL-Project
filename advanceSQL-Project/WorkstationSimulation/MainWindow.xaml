<Window x:Class="WorkstationSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workstation Simulation" Height="280" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Fog Lamp Workstation Simulation"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock x:Name="txtStation"
                       Text="Station 3"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="txtStatus"
                       Text="Running..."
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button x:Name="btnRefill"
                    Content="Refill Stock"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="btnRefill_Click"/>
        </StackPanel>
    </Grid>
</Window>