<Window x:Class="ConfigurationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban System Configuration" Height="500" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Simulation Parameters" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>

        <DataGrid x:Name="configDataGrid" AutoGenerateColumns="True" Grid.Row="1" Margin="0,0,0,15" 
                  AlternatingRowBackground="#FFF0F0F0" HeadersVisibility="Column" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
            <Button x:Name="btnReload" Content="Reload" Width="100" Height="35" Margin="0,0,10,0"
                    Click="BtnReload_Click" FontWeight="SemiBold"/>
            <Button x:Name="btnResetSim" Content="Reset Simulation" Width="140" Height="35" Margin="0,0,10,0"
                    Click="BtnResetSim_Click" Background="#FFDC3545" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="btnSaveChanges" Content="Save Changes" Width="140" Height="35"
                    Click="BtnSaveChanges_Click" Background="#FF0078D7" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>