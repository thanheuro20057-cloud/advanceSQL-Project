<Window x:Class="ConfigurationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban System Configuration" Height="450" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Simulation Parameters" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>

        <DataGrid x:Name="configDataGrid" AutoGenerateColumns="True" Grid.Row="1" Margin="0,0,0,15" 
                  AlternatingRowBackground="#FFF0F0F0" HeadersVisibility="Column" />

        <Button x:Name="btnSaveChanges" Content="Save Changes to Database" Width="180" Height="35" 
                Grid.Row="2" HorizontalAlignment="Right" Click="BtnSaveChanges_Click" 
                Background="#FF0078D7" Foreground="White" FontWeight="SemiBold"/>
    </Grid>
</Window>